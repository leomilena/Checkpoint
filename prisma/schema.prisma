generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (y otros proveedores con pooler tipo PgBouncer) necesitan una
  // conexión directa para `prisma migrate`: las migraciones usan locks
  // de advisory y sentencias preparadas que un pooler en modo transacción
  // no soporta de forma fiable.
  directUrl = env("DIRECT_URL")
}

enum Role {
  READER
  WRITER
  ADMIN
}

enum ThemePreference {
  DARK
  LIGHT
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  TRASHED
}

enum CommentStatus {
  VISIBLE
  DELETED
}

enum ReportStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum NotificationType {
  NEW_COMMENT
  ARTICLE_RETURNED
  ARTICLE_APPROVED
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  passwordHash    String
  role            Role            @default(READER)
  avatarColor     String          @default("#FFB238")
  avatarImageUrl  String?
  bio             String?         @default("")
  banned          Boolean         @default(false)
  themePreference ThemePreference @default(DARK)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  articles          Article[]           @relation("AuthorArticles")
  coauthoredOn      ArticleCoauthor[]
  comments          Comment[]
  commentReports    CommentReport[]     @relation("Reporter")
  likes             Like[]
  favorites         Favorite[]
  ratings           Rating[]
  notifications     Notification[]      @relation("Recipient")
  passwordResets    PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Topic {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Article {
  id             String        @id @default(cuid())
  title          String
  subtitle       String?
  slug           String        @unique
  body           String        @db.Text
  coverImageUrl  String?
  coverGradient  Int           @default(0)
  topicId        String
  topic          Topic         @relation(fields: [topicId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  status         ArticleStatus @default(DRAFT)
  authorId       String
  author         User          @relation("AuthorArticles", fields: [authorId], references: [id])
  coauthors      ArticleCoauthor[]
  writerRating   Float?
  avgUserRating  Float         @default(0)
  ratingsCount   Int           @default(0)
  reviewNote     String?
  commentsLocked Boolean       @default(false)
  views          Int           @default(0)
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastAutosaveAt DateTime?

  comments  Comment[]
  likes     Like[]
  favorites Favorite[]
  ratings   Rating[]
  notifications Notification[]

  @@index([status])
  @@index([topicId])
  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt])
}

model ArticleCoauthor {
  articleId String
  userId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
}

model Comment {
  id             String        @id @default(cuid())
  articleId      String
  article        Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]     @relation("Replies")
  body           String        @db.Text
  status         CommentStatus @default(VISIBLE)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  reports        CommentReport[]
  notifications  Notification[]

  @@index([articleId])
  @@index([parentId])
}

model CommentReport {
  id        String       @id @default(cuid())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter  User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason    String?
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([status])
}

model Like {
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model Favorite {
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model Rating {
  userId    String
  articleId String
  value     Float
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, articleId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model WriterApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([reviewed, createdAt])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("Recipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  articleId String?
  article   Article?          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, read])
}
