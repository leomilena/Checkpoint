# Base de datos Postgres (Neon, Supabase, RDS, Docker local, etc.)
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/theframe"
# Conexión DIRECTA (sin pooler/PgBouncer), necesaria para las migraciones de Prisma.
# Si tu proveedor no usa pooler (Postgres local, Railway sin addon de pooling...),
# pon aquí el mismo valor que DATABASE_URL. Si usas Neon, copia la conexión con
# "Pooled connection" desmarcado/"-pooler" quitado del host.
DIRECT_URL="postgresql://usuario:contrasena@localhost:5432/theframe"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-valor-aleatorio-largo-con-openssl-rand-base64-32"

# Storage de imágenes S3-compatible (AWS S3, Cloudflare R2, MinIO...)
# Si se deja vacío, las imágenes se guardan localmente en /public/uploads (solo para desarrollo).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Email transaccional (Resend) — recuperación de contraseña y boletín
RESEND_API_KEY=""
EMAIL_FROM="The Frame <no-reply@tudominio.com>"

# Secreto para invocar el endpoint de purga de papelera (cron externo)
CRON_SECRET="genera-otro-valor-aleatorio"

# Widget de la portada "últimos lanzamientos de videojuegos" (RAWG). Si se
# deja vacía, el widget simplemente no se muestra — no rompe nada.
# Cuenta gratis en https://rawg.io/login y clave en https://rawg.io/apidocs
RAWG_API_KEY=""
